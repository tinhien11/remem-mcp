{
  "name": "tdai-memory-mcp",
  "version": "0.1.3",
  "description": "Local-first MCP memory server with TDAI-style layering. No Gateway. No API key required.",
  "type": "module",
  "license": "MIT",
  "author": "tin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinhien11/tdai-memory-mcp.git"
  },
  "homepage": "https://github.com/tinhien11/tdai-memory-mcp#readme",
  "bugs": {
    "url": "https://github.com/tinhien11/tdai-memory-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "ai-agent",
    "sqlite",
    "sqlite-vec",
    "local-first"
  ],
  "bin": {
    "tdai-memory-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && mkdir -p dist/storage && cp src/storage/schema.sql dist/storage/schema.sql",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "format": "biome format --write src",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
